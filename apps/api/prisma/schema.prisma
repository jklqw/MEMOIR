datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOCKOUT_TRIGGERED
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  VAULT_CREATED
  VAULT_PASSPHRASE_ROTATED
  RECOVERY_KEY_USED
  TOTP_ENABLED
  TOTP_DISABLED
  PASSKEY_ADDED
  PASSKEY_REMOVED
  SESSION_REVOKED
  SUSPICIOUS_LOGIN
  BACKUP_EXPORTED
  ACCOUNT_DELETION_REQUESTED
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique
  passwordHash         String
  emailVerifiedAt      DateTime?
  emailVerifyTokenHash String?
  emailVerifyExpiresAt DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  accountStatus        AccountStatus @default(ACTIVE)
  totpSecretEncrypted  String?
  totpEnabled          Boolean       @default(false)
  totpBackupCodesHash  Json?
  failedLoginAttempts  Int           @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sessions             Session[]
  securityEvents       SecurityEvent[]
  vault                UserVault?
  memories             Memory[]
  attachments          Attachment[]
  backups              Backup[]

  @@map("users")
}

model UserVault {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @db.Uuid
  kdfAlgorithm           String   @default("ARGON2ID")
  kdfSalt                String
  kdfMemory              Int
  kdfIterations          Int
  kdfParallelism         Int
  wrapAlgorithm          String   @default("AES-256-GCM")
  envelopeVersion        Int      @default(1)
  wrappedDek             String
  wrappedDekNonce        String
  recoverySalt           String
  recoveryWrappedDek     String
  recoveryNonce          String
  recoveryKeyFingerprint String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_vaults")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  tokenHash        String    @unique
  familyId         String    @db.Uuid
  deviceLabel      String
  userAgentSummary String
  ipMaskedOrHash   String
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([familyId])
  @@map("sessions")
}

model SecurityEvent {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  eventType    SecurityEventType
  safeMetadata Json              @default("{}")
  createdAt    DateTime          @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("security_events")
}

model Memory {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  entryDate       DateTime
  isPinned        Boolean   @default(false)
  isTimeCapsule   Boolean   @default(false)
  unlockAt        DateTime?
  envelopeVersion Int       @default(1)
  algorithm       String    @default("AES-256-GCM")
  ciphertext      String
  nonce           String
  archivedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments     Attachment[]

  @@index([userId, createdAt])
  @@index([userId, entryDate])
  @@map("memories")
}

model Attachment {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  memoryId          String?   @db.Uuid
  isVaultItem       Boolean   @default(false)
  storageKey        String    @unique
  byteSize          Int
  wrappedFileKey    String
  fileKeyNonce      String
  encryptedMetadata String
  metaNonce         String
  fileNonce         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory            Memory?   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isVaultItem])
  @@index([memoryId])
  @@map("attachments")
}

model Backup {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  checksumSha256 String
  entryCount     Int
  byteSize       Int
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("backups")
}

