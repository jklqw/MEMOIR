# Memoir API — Environment Variables (Template)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://memoir:memoir_dev_password@localhost:5432/memoir_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=memoir_redis_password

# Security Secrets (Must be 32+ bytes in production)
SESSION_SECRET=dev_session_secret_replace_in_production_32bytes_min
SERVER_KMS_KEY=dev_server_kms_key_replace_in_production_32bytes_min
CSRF_SECRET=dev_csrf_secret_replace_in_production_32bytes_min

# Allowed Client Origin (for CORS & CSRF referer checks)
WEB_URL=http://localhost:5173

# Local File Storage Path (for encrypted attachment blobs)
STORAGE_DIR=./storage/uploads

# Mailer (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@memoir.local
